# Production profile
SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
APP_WORKING_DIR=/app/work
APP_ASSETS_DEFAULT_BACKGROUND_PATH=/app/assets/backgrounds/default.mp4
APP_FFMPEG_BINARY=ffmpeg

# Browser/CORS
APP_WEB_CORS_ALLOWED_ORIGINS=https://app.example.com
APP_WEB_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_WEB_CORS_ALLOWED_HEADERS=Authorization,Content-Type
APP_WEB_CORS_EXPOSED_HEADERS=Location
APP_WEB_CORS_ALLOW_CREDENTIALS=true

# Security
APP_JWT_SECRET=replace-with-a-random-64-character-production-secret
APP_JWT_TOKEN_TTL_SECONDS=86400
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_AUTH_PER_MINUTE=20
APP_RATE_LIMIT_GENERATE_PER_MINUTE=10
APP_RATE_LIMIT_DEFAULT_PER_MINUTE=300

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/autoshorts?sslmode=require
SPRING_DATASOURCE_USERNAME=autoshorts
SPRING_DATASOURCE_PASSWORD=replace-with-production-password

# Redis
SPRING_DATA_REDIS_HOST=redis-host
SPRING_DATA_REDIS_PORT=6379
APP_REDIS_CACHE_ENABLED=true

# RabbitMQ / CloudAMQP
SPRING_RABBITMQ_HOST=rabbitmq-host
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=replace-with-rabbitmq-user
SPRING_RABBITMQ_PASSWORD=replace-with-rabbitmq-password
APP_QUEUE_ENABLED=true

# AI
OPENAI_MOCK=false
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_REQUEST_TIMEOUT_MS=300000
HF_PROVIDER=hf-inference
HF_TEXT_PROVIDER=together
HF_IMAGE_PROVIDER=hf-inference
HF_VIDEO_PROVIDER=fal-ai
HF_TTS_PROVIDER=hf-inference
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B
HF_TTS_MODEL=
APP_TEXT_PROVIDER=huggingface
APP_VISUAL_ENABLED=true
APP_VISUAL_MOCK=false
APP_VISUAL_PROVIDER=huggingface-video
APP_VISUAL_MODEL=
APP_VISUAL_SIZE=1024x1536
APP_VISUAL_MAX_SCENES=5

# TTS
ELEVENLABS_ENABLED=true
ELEVENLABS_PROVIDER=huggingface
ELEVENLABS_MOCK=false

# S3-compatible storage
S3_MOCK=false
S3_REGION=auto
S3_BUCKET=autoshorts-assets
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_PUBLIC_BASE_URL=https://media.example.com

# Stripe billing
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_STARTER_PRICE_ID=price_replace_starter
STRIPE_PRO_PRICE_ID=price_replace_pro
STRIPE_AGENCY_PRICE_ID=price_replace_agency
STRIPE_SUCCESS_URL=https://app.example.com/app/billing?checkout=success
STRIPE_CANCEL_URL=https://app.example.com/app/billing?checkout=cancelled
STRIPE_PORTAL_RETURN_URL=https://app.example.com/app/billing

# Publish / TikTok scaffold
APP_PUBLISH_ENABLED=true
APP_PUBLISH_PROVIDER=mock
APP_PUBLISH_DEFAULT_PLATFORM=mock-social
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.example.com/api/integrations/tiktok/oauth/callback
TIKTOK_WEBHOOK_VERIFY_TOKEN=

# Outbound webhooks
APP_WEBHOOK_ENABLED=false
APP_WEBHOOK_ENDPOINT_URL=
