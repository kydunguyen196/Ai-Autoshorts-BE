# Application
# Requires Java 17 runtime for Spring Boot/Gradle plugin compatibility.
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local
APP_WORKING_DIR=./work
APP_CLEANUP_DELETE_TEMP_FILES=true
APP_CLEANUP_KEEP_FAILED_JOB_FILES=true
APP_ASSETS_DEFAULT_BACKGROUND_PATH=./assets/backgrounds/default.mp4
# Use "ffmpeg" if available in PATH, or set an absolute path to ffmpeg.exe on Windows.
# Example:
# APP_FFMPEG_BINARY=D:\project\ffmpeg\ffmpeg-8.0.1-essentials_build\ffmpeg-8.0.1-essentials_build\bin\ffmpeg.exe
APP_FFMPEG_BINARY=ffmpeg
# Optional alternate variable name supported by application.yml
FFMPEG_PATH=
APP_FFMPEG_TIMEOUT_SECONDS=180
# Set true to abort startup if the FFmpeg binary is not resolvable (default false = log only).
APP_FFMPEG_FAIL_ON_STARTUP=false

# Observability
# Structured JSON logs are emitted automatically under the production/staging profiles.
# Error tracking — leave SENTRY_DSN blank to disable (the SDK then no-ops).
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
# Actuator endpoints exposed under /actuator (health,info,prometheus,metrics by default).
MANAGEMENT_ENDPOINTS=health,info,prometheus,metrics
APP_REDIS_CACHE_ENABLED=true
APP_REDIS_CACHE_TTL_SECONDS=21600
APP_SCHEDULER_ENABLED=false
APP_SCHEDULER_FIXED_DELAY_MS=60000
APP_SCHEDULER_INITIAL_DELAY_MS=15000
APP_SCHEDULER_BATCH_SIZE=3
APP_SCHEDULER_DEFAULT_DURATION_SECONDS=30
APP_SCHEDULER_DEFAULT_VOICE_ID=
APP_SCHEDULER_TOPIC_SOURCE=scheduler
APP_QUEUE_ENABLED=true
APP_QUEUE_EXCHANGE=autoshorts.video.exchange
APP_QUEUE_ROUTING_KEY=video.generate
APP_QUEUE_NAME=autoshorts.video.generate
APP_QUEUE_DEAD_LETTER_EXCHANGE=autoshorts.video.dlx
APP_QUEUE_DEAD_LETTER_ROUTING_KEY=video.generate.dlq
APP_QUEUE_DEAD_LETTER_NAME=autoshorts.video.generate.dlq
APP_QUEUE_CONSUMER_CONCURRENCY=2
APP_QUEUE_MAX_PROCESSING_ATTEMPTS=3
APP_QUEUE_RETRY_INITIAL_INTERVAL_MS=2000
APP_QUEUE_RETRY_MULTIPLIER=2.0
APP_QUEUE_RETRY_MAX_INTERVAL_MS=10000
# Frontend / Browser CORS
# Comma-separated lists
APP_WEB_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_WEB_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_WEB_CORS_ALLOWED_HEADERS=*
APP_WEB_CORS_EXPOSED_HEADERS=Location
APP_WEB_CORS_ALLOW_CREDENTIALS=true
APP_WEB_CORS_MAX_AGE_SECONDS=3600
# Auth / JWT
# Must be at least 32 characters for HS256 signing.
APP_JWT_SECRET=replace-this-with-a-long-local-jwt-secret-min-32-chars
# Short-lived access token (default 15 min); clients refresh via /api/auth/refresh.
APP_JWT_TOKEN_TTL_SECONDS=900
APP_JWT_REFRESH_TOKEN_TTL_SECONDS=2592000
# Account lockout after N failed logins, for the given number of minutes.
APP_AUTH_LOCKOUT_THRESHOLD=5
APP_AUTH_LOCKOUT_MINUTES=15
# Only trust X-Forwarded-For for rate-limit client identity when behind a trusted proxy/CDN.
APP_RATE_LIMIT_TRUST_FORWARDED_FOR=false

# AI providers (premium)
# Text: set APP_TEXT_PROVIDER=anthropic to use Claude (claude-opus-4-8). Requires ANTHROPIC_API_KEY.
APP_TEXT_PROVIDER=huggingface
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4000
# TTS: set ELEVENLABS_PROVIDER=elevenlabs for real ElevenLabs. Requires ELEVENLABS_API_KEY + a voice id.
ELEVENLABS_PROVIDER=huggingface
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_REAL_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_REAL_OUTPUT_FORMAT=mp3_44100_128

# PostgreSQL
POSTGRES_DB=autoshorts
POSTGRES_USER=autoshorts
POSTGRES_PASSWORD=autoshorts
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/autoshorts
SPRING_DATASOURCE_USERNAME=autoshorts
SPRING_DATASOURCE_PASSWORD=autoshorts

# Redis
REDIS_PORT=6379
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=autoshorts
RABBITMQ_PASSWORD=autoshorts
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=autoshorts
SPRING_RABBITMQ_PASSWORD=autoshorts

# Keep false for the Hugging Face content client.
OPENAI_MOCK=false

# Hugging Face provider switches
# Create a token at https://huggingface.co/settings/tokens and paste it into HUGGINGFACE_API_TOKEN.
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_REQUEST_TIMEOUT_MS=300000
HF_PROVIDER=hf-inference
HF_TEXT_PROVIDER=together
HF_IMAGE_PROVIDER=hf-inference
HF_VIDEO_PROVIDER=fal-ai
HF_TTS_PROVIDER=hf-inference
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HF_VIDEO_MODEL=Wan-AI/Wan2.2-T2V-A14B
HF_TTS_MODEL=
APP_TEXT_PROVIDER=huggingface

# AI visual scene generation
APP_VISUAL_ENABLED=true
APP_VISUAL_MOCK=false
# Use "huggingface-video" to try direct text-to-video through HF_VIDEO_PROVIDER/HF_VIDEO_MODEL.
APP_VISUAL_PROVIDER=huggingface-video
APP_VISUAL_MODEL=
APP_VISUAL_SIZE=1024x1536
APP_VISUAL_MAX_SCENES=5
APP_VISUAL_REQUEST_TIMEOUT_MS=120000

# Text To Speech
ELEVENLABS_ENABLED=true
# Use Hugging Face for TTS when HF_TTS_MODEL is backed by a working Inference Provider or Endpoint.
# If no supported HF TTS model is configured, the app falls back to deterministic local preview audio.
ELEVENLABS_PROVIDER=huggingface
ELEVENLABS_OUTPUT_FORMAT=mp3
ELEVENLABS_REQUEST_TIMEOUT_MS=60000
ELEVENLABS_MOCK=false

# S3 / MinIO
S3_REGION=us-east-1
S3_BUCKET=autoshorts-assets
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/autoshorts-assets
# Public base URL used to build browser-friendly media URLs when S3_MOCK=true.
APP_STORAGE_LOCAL_PUBLIC_BASE_URL=http://localhost:8080
S3_PRESIGN_DURATION_SECONDS=86400
# true = local filesystem storage under work/mock-storage
S3_MOCK=true

# Publish pipeline
APP_PUBLISH_ENABLED=true
APP_PUBLISH_PROVIDER=mock
APP_PUBLISH_DEFAULT_PLATFORM=mock-social
# Include this marker in topic text to force deterministic mock publish failure.
APP_PUBLISH_MOCK_FAILURE_KEYWORD=[publish-fail]
APP_PUBLISH_MOCK_LATENCY_MS=50

# TikTok integration scaffold (no real secrets committed)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.publish
TIKTOK_WEBHOOK_VERIFY_TOKEN=
TIKTOK_API_BASE_URL=https://open.tiktokapis.com

# Multi-platform publishing (YouTube Shorts + Instagram Reels)
# Direct publish is OFF by default (scaffold mode). Set *_DIRECT_PUBLISH_ENABLED=true only after
# the platform's API verification/app review, with real OAuth credentials + an active connection.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload
YOUTUBE_API_BASE_URL=https://www.googleapis.com
YOUTUBE_DIRECT_PUBLISH_ENABLED=false
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SCOPES=instagram_basic,instagram_content_publish,pages_show_list
INSTAGRAM_API_BASE_URL=https://graph.facebook.com
INSTAGRAM_DIRECT_PUBLISH_ENABLED=false

# Outbound webhooks (non-blocking; persisted + retried)
APP_WEBHOOK_ENABLED=false
APP_WEBHOOK_ENDPOINT_URL=
APP_WEBHOOK_DISPATCH_BATCH_SIZE=20
APP_WEBHOOK_DISPATCH_FIXED_DELAY_MS=5000
APP_WEBHOOK_MAX_ATTEMPTS=5
APP_WEBHOOK_RETRY_INITIAL_DELAY_MS=1000
APP_WEBHOOK_RETRY_MULTIPLIER=2.0
APP_WEBHOOK_RETRY_MAX_DELAY_MS=60000
APP_WEBHOOK_REQUEST_TIMEOUT_SECONDS=10
